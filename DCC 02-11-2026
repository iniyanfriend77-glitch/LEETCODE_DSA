// 462. Minimum Moves to Equal Array Elements II (Math,Sort)(mid)


class Solution {
public:
    int minMoves2(vector<int>& nums) {
        long long minm=LLONG_MAX;
        sort(nums.begin(),nums.end());
        long long n=nums.size(),total=0;
        for(int i=0;i<nums.size();i++)
        total+=nums[i];
        long long x=0;
        for(int i=0;i<nums.size();i++)
        {
            total-=nums[i];
            long long need = (total - (n-i-1)*nums[i])+(1LL*i*nums[i]-x);
            minm=min(minm,need);
          //  total+=nums[i];
            x+=nums[i];
        }
        return (int)minm;
    }
};


