// 453. Minimum Moves to Equal Array Elements (MEDIUM) (Array Math)

class Solution {
public:
    int minMoves(vector<int>& nums) {
        int minm=INT_MAX;
        for(int x:nums)
        minm=min(minm,x);
        if(minm==INT_MAX)
        return minm;
        int tot=0;
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]!=minm)
            tot+=nums[i]-minm;
        }
        return tot;
        
    }
};


